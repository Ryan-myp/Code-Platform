# ===== Python依赖基础镜像 =====
# 包含所有Python依赖和系统工具
#
# 使用方式：
#   docker build -t code-platform-base:latest -f Dockerfile.base .
#   docker push code-platform-base:latest
#
# 然后在其他服务器上使用：
#   docker pull code-platform-base:latest
#   docker run -p 8888:8888 code-platform-base:latest

FROM python:3.13-slim

WORKDIR /app

# ===== 安装系统依赖 =====
# 包括ffmpeg、TTS相关工具、构建工具等
RUN apt-get update && apt-get install -y --no-install-recommends \
    # 构建工具
    gcc \
    g++ \
    make \
    cmake \
    autoconf \
    automake \
    libtool \
    \
    # FFmpeg及相关（视频处理核心）
    ffmpeg \
    libavcodec-dev \
    libavformat-dev \
    libavutil-dev \
    libavfilter-dev \
    libswscale-dev \
    \
    # TTS语音合成相关
    sox \
    libsox-fmt-mp3 \
    espeak \
    espeak-ng \
    \
    # 音频处理
    portaudio19-dev \
    libportaudio2 \
    \
    # 图像处理
    libjpeg-dev \
    libpng-dev \
    libwebp-dev \
    \
    # 网络工具
    curl \
    wget \
    ca-certificates \
    \
    # 数据库
    sqlite3 \
    libsqlite3-dev \
    \
    # Git
    git \
    \
    # 其他工具
    locales \
    fonts-noto-cjk \
    fonts-wqy-zenhei \
    && rm -rf /var/lib/apt/lists/* \
    && locale-gen zh_CN.UTF-8

# 设置中文环境
ENV LANG=zh_CN.UTF-8 \
    LANGUAGE=zh_CN:en \
    LC_ALL=zh_CN.UTF-8

# ===== 复制依赖文件 =====
COPY requirements.txt .
COPY pyproject.toml .

# ===== 创建虚拟环境并安装所有Python依赖 =====
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH="/app:$PYTHONPATH"

# 升级pip并安装依赖
RUN pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir -r requirements.txt

# ===== 验证安装 =====
RUN echo "验证关键依赖..." \
    && python -c "import fastapi; print(f'✅ FastAPI {fastapi.__version__}')" \
    && python -c "import uvicorn; print(f'✅ Uvicorn {uvicorn.__version__}')" \
    && python -c "import edge_tts; print(f'✅ Edge-TTS {edge_tts.__version__}')" \
    && python -c "import imageio_ffmpeg; print(f'✅ imageio-ffmpeg {imageio_ffmpeg.__version__}')" \
    && ffmpeg -version 2>&1 | head -1 \
    && ffprobe -version 2>&1 | head -1 \
    && echo "✅ 所有依赖安装完成"

# 输出依赖列表供调试
RUN pip list --format=freeze > /app/requirements_installed.txt \
    && echo "依赖总数: $(wc -l < /app/requirements_installed.txt)" \
    && echo "已安装依赖:" && head -30 /app/requirements_installed.txt

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8888/api/health || exit 1

# 暴露端口
EXPOSE 8888

CMD ["python", "--version"]
