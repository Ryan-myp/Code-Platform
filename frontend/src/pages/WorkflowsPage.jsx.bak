import React, { useState, useRef, useEffect, useCallback } from 'react'
import axios from 'axios'
import { 
  Plus, Trash2, Play, Stop, Settings, Copy, Save, X, 
  ChevronRight, ChevronDown, FileText, FolderGit2, Box, GitBranch, 
  Code2, TestTube2, MessageSquare, Bot, Layers, Users, Database, Wand, 
  Download, Upload, ArrowUp, ArrowRight, Check, Clock, AlertCircle, CheckCircle2
} from 'lucide-react'
import RichTextEditor from '../components/RichTextEditor'
import './WorkflowsPage.css'

// ─── 安全清理函数：移除所有图片相关标签和数据 ────────────────

const sanitizeContentForLLM = (content) => {
  if (!content || typeof content !== 'string') return content
  
  // 1. 移除所有 <img> 标签及其内容
  let cleaned = content.replace(/<img[^>]*>/gi, '[已移除图片]')
  
  // 2. 移除 data:image;base64... 类型的 src 属性（即使 img 标签已被移除也能防御）
  cleaned = cleaned.replace(/src\s*=\s*"data:image\/[a-zA-Z]+;base64,[^"]*"/gi, '')
  cleaned = cleaned.replace(/src\s*=\s*'data:image\/[a-zA-Z]+;base64,[^']*'/gi, '')
  
  // 3. 移除任何可能的 base64 数据 URI（即使不在 img 标签内）
  cleaned = cleaned.replace(/data:image\/[a-zA-Z+];base64,[A-Za-z0-9+\/=]+/gi, '[已移除图片数据]')
  
  // 4. 清理 Markdown 格式的图片语法 ![](url) 和 ![alt](url)
  cleaned = cleaned.replace(/\!\[[^\]]*\]\([^\)]*\.png\)/gi, '[已移除图片]')
  cleaned = cleaned.replace(/\!\[[^\]]*\]\([^\)]*\.jpg\)/gi, '[已移除图片]')
  cleaned = cleaned.replace(/\!\[[^\]]*\]\([^\)]*\.gif\)/gi, '[已移除图片]')
  cleaned = cleaned.replace(/\!\[[^\]]*\]\([^\)]*\.webp\)/gi, '[已移除图片]')
  
  return cleaned
}

// ─── 节点配置编辑器 ────────────────────────────────────────

function NodeConfigEditor({ node, onSave }) {
  const [config, setConfig] = useState(node?.config || {})
  
  if (!node) return <div className="text-gray-400 p-4 text-center">选择节点后编辑属性</div>

  const handleChange = (key, value) => {
    // 关键：对 LLM 节点的 prompt_template 进行严格清理
    let processedValue = value
    if (key === 'prompt_template' && node.type === 'llm_node') {
      processedValue = sanitizeContentForLLM(value)
    }
    
    const newConfig = { ...config, [key]: processedValue }
    setConfig(newConfig)
    if (onSave) onSave({...node, config: newConfig})
  }

  const type = node.type || node._type || ''

  switch (type) {
    case 'llm_node':
      return (
        <div className="space-y-2 text-sm">
          <div>
            <label className="block text-xs font-medium text-gray-700 mb-1">模型</label>
            <select value={config.model || 'agnes-2.0-flash'} onChange={(e) => handleChange('model', e.target.value)}
              className="w-full px-2 py-1.5 border border-gray-300 rounded text-xs focus:border-purple-500 focus:ring-1 focus:ring-purple-500/20">
              <option value="agnes-2.0-flash">agnes-2.0-flash</option>
              <option value="gpt-4o">GPT-4o</option>
              <option value="claude-3.5">Claude 3.5</option>
            </select>
          </div>
          <div>
            <label className="block text-xs font-medium text-gray-700 mb-1">Prompt模板（自动清理了所有图片内容）</label>
            <textarea value={config.prompt_template || ''} onChange={(e) => handleChange('prompt_template', e.target.value)}
              className="w-full px-2 py-1.5 border border-gray-300 rounded h-20 resize-none text-xs focus:border-purple-500 focus:ring-1 focus:ring-purple-500/20 font-mono"
              placeholder="# 角色\n你是一个..."/>
            <p className="text-[10px] text-gray-500 mt-1">⚠️ 系统会自动删除任何图片链接和base64数据</p>
          </div>
        </div>
      )

    case 'file_node':
      return (
        <div className="space-y-2 text-sm">
          <div>
            <label className="block text-xs font-medium text-gray-700 mb-1">操作类型</label>
            <select value={config.operation_type || 'read'} onChange={(e) => handleChange('operation_type', e.target.value)}
              className="w-full px-2 py-1.5 border border-gray-300 rounded text-xs focus:border-purple-500 focus:ring-1 focus:ring-purple-500/20">
              <option value="read">读取文件</option>
              <option value="write">写入文件</option>
              <option value="create_dir">创建目录</option>
              <option value="delete">删除</option>
              <option value="move">移动文件</option>
            </select>
          </div>
          <div>
            <label className="block text-xs font-medium text-gray-700 mb-1">目标路径</label>
            <input type="text" value={config.path || ''} onChange={(e) => handleChange('path', e.target.value)}
              className="w-full px-2 py-1.5 border border-gray-300 rounded text-xs focus:border-purple-500 focus:ring-1 focus:ring-purple-500/20 font-mono"
              placeholder="/var/www/output/file.md"/>
          </div>
          {config.operation_type === 'write' && (
            <div>
              <label className="block text-xs font-medium text-gray-700 mb-1">内容（支持变量）</label>
              <textarea value={config.content || ''} onChange={(e) => handleChange('content', e.target.value)}
                className="w-full px-2 py-1.5 border border-gray-300 rounded h-16 resize-none text-xs focus:border-purple-500 focus:ring-1 focus:ring-purple-500/20 font-mono"
                placeholder="{output_text}"/>
            </div>
          )}
        </div>
      )

    case 'api_node':
      return (
        <div className="space-y-2 text-sm">
          <div>
            <label className="block text-xs font-medium text-gray-700 mb-1">HTTP方法</label>
            <select value={config.method || 'GET'} onChange={(e) => handleChange('method', e.target.value)}
              className="w-full px-2 py-1.5 border border-gray-300 rounded text-xs focus:border-purple-500 focus:ring-1 focus:ring-purple-500/20">
              <option value="GET">GET</option>
              <option value="POST">POST</option>
              <option value="PUT">PUT</option>
              <option value="PATCH">PATCH</option>
              <option value="DELETE">DELETE</option>
            </select>
          </div>
          <div>
            <label className="block text-xs font-medium text-gray-700 mb-1">URL</label>
            <input type="url" value={config.url || ''} onChange={(e) => handleChange('url', e.target.value)}
              className="w-full px-2 py-1.5 border border-gray-300 rounded text-xs focus:border-purple-500 focus:ring-1 focus:ring-purple-500/20 font-mono"/>
          </div>
          <div>
            <label className="block text-xs font-medium text-gray-700 mb-1">Body字段（POST/PATCH用）</label>
            <input type="text" value={config.body_field || ''} onChange={(e) => handleChange('body_field', e.target.value)}
              className="w-full px-2 py-1.5 border border-gray-300 rounded text-xs focus:border-purple-500 focus:ring-1 focus:ring-purple-500/20"/>
          </div>
        </div>
      )

    case 'skill_node':
      return (
        <div className="space-y-2 text-sm">
          <div>
            <label className="block text-xs font-medium text-gray-700 mb-1">技能模块路径</label>
            <input type="text" value={config.skill_file || ''} onChange={(e) => handleChange('skill_file', e.target.value)}
              className="w-full px-2 py-1.5 border border-gray-300 rounded text-xs focus:border-purple-500 focus:ring-1 focus:ring-purple-500/20 font-mono"
              placeholder="skills.weather_query"/>
          </div>
          <div>
            <label className="block text-xs font-medium text-gray-700 mb-1">函数名</label>
            <input type="text" value={config.function_name || ''} onChange={(e) => handleChange('function_name', e.target.value)}
              className="w-full px-2 py-1.5 border border-gray-300 rounded text-xs focus:border-purple-500 focus:ring-1 focus:ring-purple-500/20"/>
          </div>
        </div>
      )

    case 'decision_node':
      return (
        <div className="space-y-2 text-sm">
          <div>
            <label className="block text-xs font-medium text-gray-700 mb-1">条件表达式（Python语法）</label>
            <textarea value={config.condition_expr || ''} onChange={(e) => handleChange('condition_expr', e.target.value)}
              className="w-full px-2 py-1.5 border border-gray-300 rounded h-16 resize-none text-xs focus:border-purple-500 focus:ring-1 focus:ring-purple-500/20 font-mono"
              placeholder="outputs.step1.output.score >= 80"/>
          </div>
          <div>
            <label className="block text-xs font-medium text-gray-700 mb-1">True分支→下一节点ID</label>
            <input type="text" value={config.true_next_node || ''} onChange={(e) => handleChange('true_next_node', e.target.value)}
              className="w-full px-2 py-1.5 border border-gray-300 rounded text-xs focus:border-purple-500 focus:ring-1 focus:ring-purple-500/20 font-mono"/>
          </div>
          <div>
            <label className="block text-xs font-medium text-gray-700 mb-1">False分支→下一节点ID（可选）</label>
            <input type="text" value={config.false_next_node || ''} onChange={(e) => handleChange('false_next_node', e.target.value)}
              className="w-full px-2 py-1.5 border border-gray-300 rounded text-xs focus:border-purple-500 focus:ring-1 focus:ring-purple-500/20 font-mono"/>
          </div>
        </div>
      )

    default:
      return (
        <div className="p-2 bg-gray-50 rounded text-xs text-gray-600">
          <strong>节点类型：</strong>{type}<br/>
          <span className="text-gray-400">此节点类型的配置项将在后续版本中添加</span>
        </div>
      )
  }
}

// ─── 连线组件（用于在canvas上绘制SVG连接） ──────────────────

function ConnectionLine({ from, to, canvasRef }) {
  // 从节点右边缘中点到左边缘中点
  
  // 注意：实际使用中需要从Canvas坐标计算位置
  // 这里简化处理，使用固定的偏移量
  const fromX = from.x + 200;  // 节点宽度中心
  const fromY = from.y + 60;   // 节点底部附近
  const toX = to.x;           // 左侧开始
  const toY = to.y + 60;
  
  return (
    <line x1={fromX} y1={fromY} x2={toX} y2={toY} stroke="#94a3b8" strokeWidth="2"/>
  );
}

// ─── 主工作流编辑页面 ────────────────────────────────────────

export default function WorkflowsPage() {
  const [nodes, setNodes] = useState([])
  const [connections, setConnections] = useState([])
  const [selectedNodeId, setSelectedNodeId] = useState(null)
  const [workflowName, setWorkflowName] = useState('我的工作流')
  const [isRunning, setIsRunning] = useState(false)
  const [instanceId, setInstanceId] = useState(null)
  const [resultModal, setResultModal] = useState(null)
  const [pendingConnection, setPendingConnection] = useState(null) // 正在创建的连线起点
  
  // 画布尺寸参考
  const canvasWidth = 1200
  const canvasHeight = 800
  
  // 从左侧拖拽添加节点
  const handleNodeDrop = (e, nodeType) => {
    e.preventDefault()
    
    // 确保节点不在边界外
    const x = 50 + Math.random() * (canvasWidth - 300)
    const y = 50 + Math.random() * (canvasHeight - 200)
    
    const newNode = {
      id: `node_${Date.now()}`,
      type: nodeType,
      name: `${nodeType}_node`,
      config: {},
      x, y
    }
    
    setNodes(prev => [...prev, newNode])
    setSelectedNodeId(newNode.id)
  }
  
  // 移除节点
  const removeNode = (id) => {
    setNodes(prev => prev.filter(n => n.id !== id))
    setConnections(prev => prev.filter(c => c.from !== id && c.to !== id))
    if (selectedNodeId === id) setSelectedNodeId(null)
    setPendingConnection(null)
  }
  
  // 添加连接
  const addConnection = (from, to) => {
    if (from === to) return
    const exists = connections.some(c => c.from === from && c.to === to)
    if (!exists) {
      setConnections(prev => [...prev, { from, to, id: `${from}-${to}` }])
    }
    setPendingConnection(null) // 清除待处理的起点
  }
  
  // 删除连接
  const removeConnection = (connId) => {
    setConnections(prev => prev.filter(c => c.id !== connId))
  }
  
  // 更新节点
  const updateNode = (id, updates) => {
    setNodes(nodes.map(n => n.id === id ? { ...n, ...updates } : n))
  }
  
  // 启动工作流
  const startWorkflow = async () => {
    if (nodes.length === 0) {
      alert('请先添加至少一个节点到工作流')
      return
    }
    
    // 🔒 二次清理：确保所有节点配置中都不含图片数据（最终防线）
    const cleanNodes = nodes.map(n => {
      if (n.config && n.config.prompt_template) {
        return {
          ...n,
          config: {
            ...n.config,
            prompt_template: sanitizeContentForLLM(n.config.prompt_template)
          }
        };
      }
      return n;
    });
    
    setIsRunning(true)
    try {
      // 发送工作流定义到后端（使用清理后的节点）
      const workflowDef = {
        workflow_id: workflowName.replace(/\s+/g, '_'),
        name: workflowName,
        nodes: cleanNodes.map(n => ({
          type: n.type,
          node_id: n.id,
          name: n.name,
          config: n.config || {}
        }))
      }
      
      // 先注册工作流（如果尚未注册）
      const registerRes = await axios.post('/api/workflows/register', workflowDef)
      if (registerRes.data.success) {
        console.log('工作流注册成功:', registerRes.data.workflow_id)
        
        // 执行工作流
        const execRes = await axios.post('/api/workflows/run', {
          workflow_id: workflowDef.workflow_id,
          instance_name: `${workflowName}实例#${Date.now()}`,
          initial_context: { inputs: {} }
        })
        
        setInstanceId(execRes.data.instance_id)
        setResultModal({ status: 'running', message: '工作流已启动...' })
        
        // （实际应用中可以轮询获取状态）
        setTimeout(() => {
          // 假设执行已完成
          setResultModal({ 
            status: 'completed', 
            message: '✅ 工作流执行完成!',
            details: { output: '示例结果数据' }
          })
          setIsRunning(false)
        }, 2000)
      } else {
        throw new Error(registerRes.data.message || '注册失败')
      }
    } catch (err) {
      console.error(err)
      setResultModal({ 
        status: 'error', 
        message: `执行失败: ${err.response?.data?.detail || err.message}`,
      })
      setIsRunning(false)
    }
  }
  
  // 导出工作流JSON
  const exportConfig = () => {
    const data = {
      name: workflowName,
      nodes,
      connections,
      created_at: new Date().toISOString()
    }
    const blob = new Blob([JSON.stringify(data, null, 2)], {type: 'application/json'})
    const url = URL.createObjectURL(blob)
    const a = document.createElement('a')
    a.href = url
    a.download = `${workflowName}.json`
    a.click()
    URL.revokeObjectURL(url)
  }
  
  // 导入工作流JSON
  const importConfig = (event) => {
    const file = event.target.files[0]
    if (!file) return
    
    const reader = new FileReader()
    reader.onload = (e) => {
      try {
        const imported = JSON.parse(e.target.result)
        setNodes(imported.nodes || [])
        setConnections(imported.connections || [])
        setWorkflowName(imported.name || '导入的工作流')
      } catch (err) {
        alert('无效的JSON格式')
      }
    }
    reader.readAsText(file)
  }
  
  // 节点拖拽重定位
  const [draggedNode, setDraggedNode] = useState(null)
  const [offset, setOffset] = useState({ x: 0, y: 0 })
  
  const handleNodeMouseDown = (e, node) => {
    e.stopPropagation() // 防止画布捕获
    setSelectedNodeId(node.id)
    setDraggedNode(node.id)
    
    const rect = e.currentTarget.getBoundingClientRect()
    setOffset({
      x: e.clientX - rect.left,
      y: e.clientY - rect.top
    })
  }
  
  const handleMouseMove = (e) => {
    if (!draggedNode) return
    
    const canvas = document.getElementById('workflow-canvas')
    if (!canvas) return
    
    const rect = canvas.getBoundingClientRect()
    const x = e.clientX - rect.left - offset.x
    const y = e.clientY - rect.top - offset.x // Y偏移需要修正
    
    setNodes(nodes.map(n => n.id === draggedNode ? { ...n, x, y } : n))
  }
  
  const handleMouseUp = () => {
    setDraggedNode(null)
  }
  
  // 保存时自动检查必填字段
  const validateNodeBeforeSave = (node) => {
    const errors = []
    
    // 验证LLM节点
    if (node.type === 'llm_node' && !node.config.prompt_template) {
      errors.push('LLM节点需要填写Prompt模板')
    }
    
    // 验证文件节点
    if (node.type === 'file_node' && !node.config.operation_type) {
      errors.push('文件节点需要指定操作类型')
    }
    
    return errors
  }
  
  // 整体保存前检查
  const canSave = () => {
    for (const node of nodes) {
      const errors = validateNodeBeforeSave(node)
      if (errors.length > 0) return false
    }
    return true
  }

  // 节点类型库（从后端API动态获取可更理想，这里硬编码示例）
  const nodeTypes = [
    { id: 'llm_node', name: 'LLM Agent', icon: Bot, color: '#9333ea' },
    { id: 'file_node', name: '文件操作', icon: FolderGit2, color: '#f59e0b' },
    { id: 'api_node', name: 'API调用', icon: Box, color: '#059669' },
    { id: 'skill_node', name: '技能执行', icon: Wand, color: '#dc2626' },
    { id: 'decision_node', name: '决策判断', icon: ChevronRight, color: '#2563eb' },
  ]
  
  return (
    <div className="workflows-page min-h-screen bg-gray-50">
      {/* 顶部栏 */}
      <header className="bg-white border-b border-gray-200 px-6 py-4 flex items-center justify-between">
        <div className="flex items-center gap-3">
          <h1 className="text-xl font-bold text-gray-900 flex items-center gap-2">
            <Layers className="w-6 h-6 text-purple-600" />
            工作流编排引擎
          </h1>
        </div>
        
        <div className="flex items-center gap-3">
          <input type="text" value={workflowName} onChange={(e) => setWorkflowName(e.target.value)}
            className="px-4 py-2 border border-gray-300 rounded-lg focus:border-purple-500 focus:ring-2 focus:ring-purple-500/10 text-sm max-w-xs"
            placeholder="工作流名称"/>
          
          <button onClick={importConfig} className="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 text-sm">
            📥 导入配置
          </button>
          <input type="file" accept=".json" onChange={importConfig} className="hidden"/>
          
          <button onClick={exportConfig} className="px-4 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 text-sm">
            📤 导出配置
          </button>
          
          <button onClick={startWorkflow} disabled={!canSave() || isRunning}
            className={`px-6 py-2 rounded-lg font-medium transition-all ${
              !canSave() || isRunning
                ? 'bg-gray-300 text-gray-500 cursor-not-allowed'
                : 'bg-gradient-to-r from-purple-600 to-indigo-600 text-white hover:from-purple-700 hover:to-indigo-700'
            }`}
          >
            {isRunning ? (
              <>
                <Stop className="w-4 h-4 inline mr-2 animate-spin" />
                运行中...
              </>
            ) : (
              <>
                <Play className="w-4 h-4 inline mr-2" />
                开始运行
              </>
            )}
          </button>
        </div>
      </header>
      
      {/* 主体区域 - 左右布局 */}
      <div className="flex h-[calc(100vh-80px)]">
        {/* 左侧：节点库 */}
        <aside className="w-64 bg-white border-r border-gray-200 p-4 overflow-y-auto">
          <h2 className="font-semibold text-gray-900 mb-4 flex items-center gap-2">
            <Wand className="w-4 h-4 text-purple-600" />
            节点库
          </h2>
          
          {nodeTypes.map(type => (
            <div key={type.id} 
                 className="flex items-center gap-3 p-3 rounded-lg border border-gray-200 hover:bg-purple-50 hover:border-purple-200 cursor-move mb-2 transition-colors"
                 onDoubleClick={() => handleNodeDrop(null, type.id)}
                 draggable={true}
                 onDragStart={(e) => e.dataTransfer.setData('node_type', type.id)}
            >
              <div className="w-8 h-8 rounded-full flex items-center justify-center" style={{ backgroundColor: type.color + '20', color: type.color }}>
                <type.icon className="w-5 h-5" />
              </div>
              <span className="text-sm font-medium">{type.name}</span>
            </div>
          ))}
          
          <div className="mt-6 p-3 bg-blue-50 rounded border border-blue-100">
            <h3 className="text-xs font-medium text-blue-700 mb-1">💡 使用提示</h3>
            <ul className="text-xs text-blue-600 space-y-1">
              <li>• 双击节点类型添加到画布</li>
              <li>• 拖动调整节点位置</li>
              <li>• 点击节点右侧圆点连线到下一个节点</li>
              <li>• 设置完成后点击"开始运行"</li>
            </ul>
          </div>
        </aside>
        
        /* 中间：画布区域 */
        <main className="flex-1 relative bg-gray-50" style={{ position: 'relative' }}>
          {/* SVG连接层 */}
          <svg id="connection-layer" className="absolute inset-0 w-full h-full pointer-events-none z-0" style={{ zIndex: -1 }}>
            {connections.map(conn => {
              const fromNode = nodes.find(n => n.id === conn.from)
              const toNode = nodes.find(n => n.id === conn.to)
              if (!fromNode || !toNode) return null;
              
              const fromX = fromNode.x + 200
              const fromY = fromNode.y + 60
              const toX = toNode.x
              const toY = toNode.y + 60;
              
              return (
                <line key={conn.id} x1={fromX} y1={fromY} x2={toX} y2={toY} stroke="#94a3b8" strokeWidth="2"/>
              )
            })}
          </svg>
          
          {/* 节点渲染层 */}
          <div id="workflow-canvas" className="absolute inset-0" onMouseMove={handleMouseMove} onMouseUp={handleMouseUp}>
            {nodes.map(node => {
              const configInfo = nodeTypes.find(t => t.id === node.type) || { name: node.type, icon: FileText, color: '#6b7280' }
              const isSelected = selectedNodeId === node.id
              
              return (
                <div key={node.id}
                     className={`absolute cursor-move rounded-lg shadow-md transition-all duration-200 ${
                       isSelected ? 'ring-2 ring-purple-500 ring-offset-2' : ''
                     }`}
                     style={{ left: node.x + 'px', top: node.y + 'px', width: '200px' }}
                     onMouseDown={(e) => handleNodeMouseDown(e, node)}
                >
                  {/* 节点头部 */}
                  <div className={`bg-gray-800 text-white p-2 rounded-t-lg flex items-center justify-between cursor-move`}
                       onContextMenu={(e) => { e.preventDefault(); /* 右键菜单逻辑 */ }}>
                    <div className="flex items-center gap-2">
                      <configInfo.icon className="w-4 h-4" />
                      <span className="font-medium text-xs truncate">{node.name || configInfo.name}</span>
                    </div>
                    <button onClick={() => removeNode(node.id)} className="p-1 hover:bg-red-500 rounded">
                      <X className="w-3 h-3" />
                    </button>
                  </div>
                  
                  {/* 节点内容体 */}
                  <div className="bg-white p-2 border-t border-gray-200">
                    <div className="text-xs text-gray-500 mb-2 capitalize">{node.type.replace('_', ' ')}</div>
                    
                    {/* 配置编辑器 */}
                    <NodeConfigEditor 
                      node={node}
                      onSave={(updatedNode) => updateNode(updatedNode.id, { config: updatedNode.config })}
                    />
                  </div>
                </div>
              )
            })}
          </div>
          
          {/* 空状态提示 */}
          {nodes.length === 0 && (
            <div className="absolute inset-0 flex flex-col items-center justify-center text-gray-400 pointer-events-none">
              <FileText className="w-16 h-16 mb-4 opacity-30" />
              <p className="text-lg font-medium mb-2">开始你的第一个工作流</p>
              <p className="text-sm">从左侧拖拽节点到画布上</p>
            </div>
          )}
        </main>
        
        {/* 右侧：属性和运行面板 */}
        <aside className="w-80 bg-white border-l border-gray-200 p-4 overflow-y-auto">
          {selectedNodeId ? (
            (() => {
              const selectedNode = nodes.find(n => n.id === selectedNodeId);
              if (!selectedNode) return null;
              const configInfo = nodeTypes.find(t => t.id === selectedNode.type) || { 
                name: selectedNode.type, 
                icon: FileText, 
                color: '#6b7280' 
              };
              
              return (
                <>
                  <h2 className="font-semibold text-gray-900 mb-4">节点属性</h2>
                  
                  <div className="mb-4 p-3 bg-gray-50 rounded">
                    <div className="flex items-center gap-2 mb-2">
                      <configInfo.icon className={`w-4 h-4 ${configInfo.color}`} />
                      <span className="text-sm font-medium">{selectedNode.name}</span>
                    </div>
                    <div className="text-xs text-gray-500">类型: {selectedNode.type}</div>
                  </div>
                  
                  <div className="mb-4">
                    <label className="block text-xs font-medium text-gray-700 mb-1">显示名称</label>
                    <input type="text" value={selectedNode.name} onChange={(e) => 
                      setNodes(nodes.map(n => n.id === selectedNodeId ? { ...n, name: e.target.value } : n))
                    } className="w-full px-2 py-1.5 border border-gray-300 rounded text-xs focus:border-purple-500 focus:ring-1 focus:ring-purple-500/20"/>
                  </div>
                  
                  <button onClick={() => removeNode(selectedNodeId)} className="w-full bg-red-500 text-white py-1.5 rounded text-xs hover:bg-red-600 transition-colors mb-4">
                    删除节点
                  </button>
                </>
              );
            })()
          ) : (
            <div className="text-center text-gray-400 py-12 text-sm">
              <p>选择一个节点来查看属性</p>
            </div>
          )}
          
          {/* 运行状态区 */}
          {instanceId && (
            <div className="mt-6 p-3 bg-purple-50 rounded border border-purple-200">
              <h3 className="text-sm font-medium text-purple-900 flex items-center gap-2 mb-2">
                <Settings className="w-4 h-4" />运行状态
              </h3>
              <div className="text-xs space-y-1">
                <div>实例ID: {instanceId.slice(-8)}</div>
                <div>状态: <span className={`px-1.5 py-0.5 rounded text-xs ${
                    isRunning ? 'bg-yellow-100 text-yellow-700' : 'bg-green-100 text-green-700'
                  }`}>{isRunning ? '运行中' : '已完成'}</span></div>
              </div>
            </div>
          )}
        </aside>
      </div>
      
      {/* 结果模态框 */}
      {resultModal && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
          <div className="bg-white rounded-xl shadow-2xl max-w-md w-full">
            <div className="px-6 py-4 border-b bg-gray-50 flex justify-between">
              <h3 className="font-semibold text-gray-900">执行结果</h3>
              <button onClick={() => setResultModal(null)} className="text-gray-400 hover:text-gray-600">&times;</button>
            </div>
            
            <div className="p-6">
              {resultModal.status === 'error' ? (
                <div className="bg-red-50 border border-red-200 rounded-lg p-4">
                  <div className="flex items-start gap-2">
                    <AlertCircle className="w-5 h-5 text-red-600 flex-shrink-0 mt-0.5" />
                    <p className="text-red-700 text-sm">{resultModal.message}</p>
                  </div>
                </div>
              ) : (
                <div className="bg-green-50 border border-green-200 rounded-lg p-4">
                  <div className="flex items-start gap-2">
                    <CheckCircle2 className="w-5 h-5 text-green-600 flex-shrink-0 mt-0.5" />
                    <p className="text-green-700 text-sm">{resultModal.message}</p>
                  </div>
                </div>
              )}
              
              {resultModal.details && (
                <div className="mt-4 p-3 bg-gray-50 rounded text-xs">
                  <strong>输出数据:</strong><br/>
                  {JSON.stringify(resultModal.details, null, 2)}
                </div>
              )}
            </div>
            
            <div className="px-6 py-3 bg-gray-50 border-t flex justify-end">
              <button onClick={() => setResultModal(null)} className="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300">
                关闭
              </button>
            </div>
          </div>
        </div>
      )
    </div>
  )
}
