# ─── LLM 配置 ───────────────────────────────────────────────────
AGNES_API_KEY=your-api-key-here
AGNES_API_BASE=https://apihub.agnes-ai.com/v1
MODEL_NAME=agnes-2.0-flash

# 图片 / 视频生成模型（留空则使用内置默认；也可在系统配置页运行中修改，无需重启）
# 切 gpt-image 等供应商模型时，需确保 AGNES_API_BASE / AGNES_API_KEY 指向该供应商通道
IMAGE_MODEL=agnes-image-2.1-flash
VIDEO_MODEL=agnes-video-v2.0

# 视频备用通道（预留）：阿里云百炼 wan2.2 文生视频，配置后 agnes 失败时自动 failover
DASHSCOPE_API_KEY=
AI_VIDEO_CHANNELS=agnes,dashscope

# ─── 服务配置 ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8888
DEBUG=false

# ─── 认证配置 ───────────────────────────────────────────────────
# ⚠️ 生产环境必须修改此密钥！
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── 数据库配置 ─────────────────────────────────────────────────
# 默认使用 SQLite（本地开发/单机部署）
DB_PATH=./backend/platform.db

# ─── MySQL 配置（企业级部署可选）──────────────────────────────
# 启用 MySQL 时设置 DB_ENGINE=mysql，连接串格式：
# mysql+pymysql://user:password@host:port/dbname
# 本地已创建独立实例：db=code_platform，用户=code_platform（见 docs/enterprise-mysql.md）
DB_ENGINE=sqlite
DATABASE_URL=mysql+pymysql://code_platform:CodePlatform@2026@127.0.0.1:3306/code_platform?charset=utf8mb4

# ─── CORS 配置 ──────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── 外部引擎配置 ───────────────────────────────────────────────
# biz-delivery 目录路径（留空则自动 fallback 到内置 Agent）
BIZ_DELIVERY_DIR=
